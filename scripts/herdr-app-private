#!/usr/bin/env bash
# Starts or stops a private herdr-app, off the user's screen: a headless sway as its display,
# its own herdr-app home and its own herdr-core, so a check sees the real herdr-app render of the
# review pane without touching the user's window or core. `.agents/wiki/herdr-app.md` says how
# to drive it.
#
# Usage: scripts/herdr-app-private start [WIDTHxHEIGHT]   prints the env file to source
#        scripts/herdr-app-private stop <env file>
set -euo pipefail

start() {
  local size="${1:-1600x1000}" dir
  # Short, under /tmp: herdr-core refuses a socket path over 107 bytes.
  dir="$(mktemp -d /tmp/herdr-app-private.XXXXXX)"
  mkdir -p "$dir"/{run,state,config,data,cache,app}
  chmod 700 "$dir/run"
  cat >"$dir/env" <<EOF
unset HC_SCOPE HC_TERMINAL_ID HC_TERMINAL_SOCKET DISPLAY
export WAYLAND_DISPLAY=$dir/run/wayland-1 XDG_RUNTIME_DIR=$dir/run HC_SESSION=private
export HERDR_APP_HOME=$dir/app XDG_STATE_HOME=$dir/state XDG_CONFIG_HOME=$dir/config
export XDG_DATA_HOME=$dir/data XDG_CACHE_HOME=$dir/cache
export SWAYSOCK=\$(echo $dir/run/sway-ipc.*.sock)
EOF
  # A start that fails ends what it started.
  trap "stop '$dir/env'" EXIT
  printf 'output HEADLESS-1 resolution %s\nxwayland disable\ndefault_border none\n' "$size" >"$dir/sway.conf"
  # Vulkan finds no DRM device on a headless backend: GLES renders instead.
  env -u SWAYSOCK -u WAYLAND_DISPLAY -u DISPLAY XDG_RUNTIME_DIR="$dir/run" \
    WLR_BACKENDS=headless WLR_RENDERER=gles2 WLR_LIBINPUT_NO_DEVICES=1 \
    setsid sway -c "$dir/sway.conf" >"$dir/sway.log" 2>&1 </dev/null &
  echo $! >"$dir/sway.pid"
  for _ in $(seq 100); do [ -S "$dir/run/wayland-1" ] && break; sleep 0.1; done
  [ -S "$dir/run/wayland-1" ] || { echo "sway did not start: $dir/sway.log" >&2; exit 1; }
  (
    # shellcheck disable=SC1091
    . "$dir/env"
    setsid herdr-app >"$dir/herdr-app.log" 2>&1 </dev/null &
    echo $! >"$dir/herdr-app.pid"
    # Up once it renders a frame.
    for _ in $(seq 100); do herdr-app shot "$dir/first.png" >/dev/null 2>&1 && exit 0; sleep 0.2; done
    echo "herdr-app did not start: $dir/herdr-app.log" >&2
    exit 1
  )
  trap - EXIT
  echo "$dir/env"
}

stop() {
  local env="$1" dir
  dir="$(dirname "$env")"
  [ -f "$dir/sway.conf" ] || { echo "not a private herdr-app: $dir" >&2; exit 1; }
  (
    # shellcheck disable=SC1091
    . "$env"
    # Never the user's core: only the one this script started.
    [ "${HC_SESSION:-}" = private ] || exit 0
    kill "$(cat "$dir/herdr-app.pid" 2>/dev/null)" 2>/dev/null || true
    hc server stop >/dev/null 2>&1 || true
  )
  kill "$(cat "$dir/sway.pid" 2>/dev/null)" 2>/dev/null || true
  rm -rf "$dir"
}

case "${1:-}" in
  start) start "${2:-}" ;;
  stop) stop "${2:?usage: scripts/herdr-app-private stop <env file>}" ;;
  *)
    echo "usage: scripts/herdr-app-private start [WIDTHxHEIGHT] | stop <env file>" >&2
    exit 2
    ;;
esac
