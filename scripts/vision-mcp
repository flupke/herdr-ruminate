#!/usr/bin/env bash
# Runs the vision MCP server on standard input and output (.agents/wiki/tui-vision.md).
# `.mcp.json` registers it; `make vision` builds it. A missing or stale server is built first, in
# the dev shell, with a note and the build output on standard error: standard output carries the
# MCP messages. The server gets the dev shell's pinned herdr-app, hc, Weston and Vulkan driver,
# which its app sandbox runs, and replaces this script, so the client's signals reach it.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
server="$root/tests/tui/target/debug/reviewer-vision"
cd "$root"
stale() {
  [ ! -x "$server" ] && return 0
  [ -n "$(find tests/tui/src tests/tui/Cargo.toml tests/tui/Cargo.lock crates \
    -path '*/target' -prune -o -type f -newer "$server" -print -quit)" ]
}
if stale; then
  echo "reviewer-vision: building the vision MCP server (make vision builds it ahead)" >&2
  scripts/dev-shell cargo build --quiet --locked --manifest-path tests/tui/Cargo.toml \
    --bin reviewer-vision >&2
  touch "$server"
fi
# shellcheck disable=SC2016
eval "$(scripts/dev-shell bash -c 'for name in TEST_HERDR_APP_BIN_PATH TEST_HC_BIN_PATH \
  TEST_WESTON_BIN_PATH TEST_HERDR_APP_VULKAN_DRIVER; do printf "export %s=%q\n" "$name" "${!name}"; done')"
exec "$server"
